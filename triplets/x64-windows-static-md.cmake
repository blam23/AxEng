set(VCPKG_TARGET_ARCHITECTURE x64)
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE static)

set(VCPKG_ENV_PASSTHROUGH AXENG_CLANG_CL AXENG_VS_TOOLSET_VERSION AXENG_WINDOWS_SDK_VERSION)
foreach(variable IN ITEMS AXENG_CLANG_CL AXENG_VS_TOOLSET_VERSION AXENG_WINDOWS_SDK_VERSION)
    if("$ENV{${variable}}" STREQUAL "")
        message(FATAL_ERROR "${variable} must be supplied by xmake; configure dependencies through xmake f")
    endif()
endforeach()
set(VCPKG_PLATFORM_TOOLSET_VERSION "$ENV{AXENG_VS_TOOLSET_VERSION}")
set(VCPKG_CMAKE_SYSTEM_VERSION "$ENV{AXENG_WINDOWS_SDK_VERSION}")
set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE "${CMAKE_CURRENT_LIST_DIR}/clang-cl.cmake")
set(VCPKG_LOAD_VCVARS_ENV ON)
set(VCPKG_C_FLAGS_DEBUG "/D_ITERATOR_DEBUG_LEVEL=2")
set(VCPKG_CXX_FLAGS_DEBUG "/D_ITERATOR_DEBUG_LEVEL=2")
set(VCPKG_C_FLAGS_RELEASE "/D_ITERATOR_DEBUG_LEVEL=0")
set(VCPKG_CXX_FLAGS_RELEASE "/D_ITERATOR_DEBUG_LEVEL=0")
