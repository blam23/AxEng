{
   "compiler":{
      "type":"msvc"
   },
   "default_config":"fast_debug",
   "configs":{
      "fast_debug":{
         "compile_scripts":false,
         "flags":"/O2 /Ot /Oi /dynamicdeopt",
         "strip_compiled_script_symbols":false,
         "defines":[
            "DEBUG",
            "FASTDEBUG"
         ]
      },
      "release":{
         "compile_scripts":true,
         "flags":"/O2 /Ot /Oi /GL",
         "strip_compiled_script_symbols":true,
         "defines":[
            "RELEASE"
         ]
      },
      "debug":{
         "compile_scripts":false,
         "flags":"/Od",
         "strip_compiled_script_symbols":false,
         "defines":[
            "DEBUG"
         ]
      }
   },
   "all_configs":{
      "flags":"/std:c++latest /std:clatest /utf-8",
      "defines":[

      ]
   }
}